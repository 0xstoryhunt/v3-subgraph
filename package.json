{
  "name": "storyhunt-v3-subgraph",
  "version": "1.0.0",
  "repository": "https://github.com/0xstoryhunt/v3-subgraph.git",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "eslint . --ext .ts --fix",
    "build": "run-s codegen && graph build",
    "build:docker": "docker build -t matchstick .",
    "buildonly": "graph build",
    "codegen": "graph codegen --output-dir src/types/",
    "test": "graph test -d",
    "test:no-tty": "docker run -i --rm --mount type=bind,source=$INIT_CWD,target=/matchstick matchstick",
    "deploy": "goldsky subgraph deploy mainnet/1.0.0-story-hunt-address-string",
    "deploy-local": "graph create uniswap-v3-story --node http://localhost:8020 && graph deploy uniswap-v3-story --ipfs http://127.0.0.1:5001 --node http://localhost:8020 subgraph.yaml"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.64.1",
    "@graphprotocol/graph-ts": "^0.32.0",
    "@types/fs-extra": "^11.0.4",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^6.1.0",
    "fs-extra": "^11.3.0",
    "matchstick-as": "^0.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.18.2",
    "typescript": "^3.5.2",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "@storyhunt/default-list": "^1.0.4",
    "dotenv": "^16.4.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
